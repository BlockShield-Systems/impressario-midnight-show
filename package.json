{
  "name": "impressario-midnight-show-m6c",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "leaderboard:dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply impressario-leaderboard --local",
    "db:migrate:remote": "wrangler d1 migrations apply impressario-leaderboard --remote",
    "deploy": "npm run build && wrangler deploy",
    "assets:check": "bash scripts/check-asset-toolchain.sh",
    "assets:player": "bash scripts/export-player-atlas.sh",
    "assets:player:validate": "node scripts/validate-player-atlas.mjs",
    "assets:audio": "bash scripts/export-audio.sh",
    "assets:build": "npm run assets:player && npm run assets:enemies && npm run assets:audio && npm run build",
    "assets:enemies": "bash scripts/generate-enemy-source.sh && bash scripts/export-enemy-atlas.sh",
    "assets:enemies:validate": "node scripts/validate-enemy-atlas.mjs"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "wrangler": "4.123.0"
  }
}
