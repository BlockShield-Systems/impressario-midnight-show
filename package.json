{
  "name": "impressario-midnight-show-m6c",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "leaderboard:dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply impressario-leaderboard --local",
    "db:migrate:remote": "wrangler d1 migrations apply impressario-leaderboard --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "wrangler": "4.123.0"
  }
}
