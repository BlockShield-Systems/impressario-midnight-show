{
  "name": "impressario-midnight-show-m6c",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run levels:validate && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "leaderboard:dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply impressario-leaderboard --local",
    "db:migrate:remote": "wrangler d1 migrations apply impressario-leaderboard --remote",
    "deploy": "npm run build && wrangler deploy",
    "assets:check": "bash scripts/check-asset-toolchain.sh",
    "assets:player": "bash scripts/export-player-atlas.sh",
    "assets:player:validate": "node scripts/validate-player-atlas.mjs",
    "assets:audio": "python3 scripts/audio-pipeline.py all",
    "assets:build": "npm run assets:world && npm run assets:player && npm run assets:enemies && npm run assets:boss && npm run assets:audio && npm run build",
    "assets:enemies": "bash scripts/generate-enemy-source.sh && bash scripts/export-enemy-atlas.sh",
    "assets:enemies:validate": "node scripts/validate-enemy-atlas.mjs",
    "assets:boss": "bash scripts/generate-boss-source.sh && bash scripts/export-boss-atlas.sh",
    "assets:boss:validate": "node scripts/validate-boss-atlas.mjs",
    "assets:audio:prepare": "python3 scripts/audio-pipeline.py prepare",
    "assets:audio:validate": "python3 scripts/audio-pipeline.py validate",
    "assets:audio:export": "python3 scripts/audio-pipeline.py export",
    "audio:runtime:validate": "node scripts/validate-audio-runtime.mjs",
    "test:audio:e2e": "playwright test tests/audio-runtime.spec.ts",
    "test:audio:e2e:headed": "playwright test tests/audio-runtime.spec.ts --headed",
    "levels:sync": "node scripts/sync-ldtk-world.mjs",
    "levels:validate": "node scripts/sync-ldtk-world.mjs --check",
    "assets:world": "python3 scripts/generate-environment-tiles.py"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "wrangler": "4.123.0"
  }
}
